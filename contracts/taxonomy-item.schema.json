{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://database.locobox.ch/schemas/taxonomy-item.schema.json",
  "title": "Locobox Taxonomy Item",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "slug"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9]+(?:-[a-zA-Z0-9]+)*$",
      "description": "Kurzcode; Grossbuchstaben erlaubt (z. B. Massstab H0 im Slug)."
    },
    "description": {
      "type": "string"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "description": "Zusätzliche erlaubte Werte (z. B. Hersteller-Rohlabel), die in Artikeln vorkommen dürfen."
    },
    "kind": {
      "type": "string",
      "enum": ["neuheiten"],
      "description": "Optionale Kampagnen-Art. Nur für Tags unter config/tags/ gesetzt."
    },
    "manufacturerSlug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Hersteller-Slug für Kampagnen-Tiles auf Herstellerseiten."
    },
    "year": {
      "type": "integer",
      "minimum": 1990,
      "maximum": 2100,
      "description": "Kalenderjahr der Kampagne (primäre Sortierung)."
    },
    "order": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000,
      "description": "Reihenfolge innerhalb desselben Jahres; höher = neuer/später."
    },
    "source": {
      "type": "string",
      "pattern": "^https://",
      "description": "HTTPS-URL zum Katalog-PDF oder zur Kampagnen-Webseite."
    }
  }
}
