{
  "name": "locobox-public-database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "validate:data": "node tools/validate-data.mjs",
    "build:index": "node tools/build-search-index.mjs",
    "build:site": "node tools/build-site-stub.mjs",
    "test": "node --test ./test/*.test.mjs",
    "build:check": "npm run lint && npm run format:check && npm run test && npm run validate:data && npm run build:index && npm run build:site",
    "check": "npm run build:check"
  },
  "dependencies": {
    "country-flag-icons": "^1.6.17"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.2.1",
    "fast-glob": "^3.3.3",
    "globals": "^17.5.0",
    "prettier": "^3.8.3"
  }
}
